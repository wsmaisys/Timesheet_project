# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-strong-random-secret-key-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=false

# Database (leave unset in local dev to use SQLite)
# DATABASE_URL=postgres://timesheet:timesheet_dev_pwd@localhost:5432/timesheet

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Background jobs & email
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@timesheet.example.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
